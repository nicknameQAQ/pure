{
  "name": "pure",
  "version": "0.3.0",
  "description": "pure — 简约的本地 Markdown 编辑与阅读工具",
  "productName": "pure",
  "author": "pure",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "test:features": "node tests/features.mjs",
    "test:workspace": "node tests/workspace.mjs",
    "dist": "npm run build && node scripts/prepare-dist.mjs && electron-builder --win portable zip --x64 --publish never",
    "release:assets": "node scripts/release-assets.mjs"
  },
  "build": {
    "appId": "local.pure.editor",
    "productName": "pure",
    "directories": {
      "output": "release",
      "app": "dist-app"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "artifactName": "pure-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "pure",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "useZip": true,
      "artifactName": "pure-${version}-x64-portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@milkdown/components": "^7.22.3",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
